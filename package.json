{
  "name": "spaceport-bazaar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run test:worker && npm run check",
    "explore:market": "node scripts/explore-market.mjs",
    "proto:generate": "pbjs -t static-module -w commonjs --keep-case --force-long -o worker/generated/bazaar.js artifacts/bazaar-protobuf-starter-linux/bazaar.proto && pbts -o worker/generated/bazaar.d.ts worker/generated/bazaar.js",
    "worker": "tsx worker/main.ts",
    "worker:exercise": "tsx worker/main.ts --exercise",
    "test:worker": "tsx --test worker/tests/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude=\"worker/generated/**\" --test-coverage-exclude=\"worker/tests/**\" worker/tests/*.test.ts",
    "test:validator": "tsx worker/tests/validator.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "long": "^5.3.2",
    "next": "^16.3.5",
    "protobufjs": "^8.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "protobufjs-cli": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
