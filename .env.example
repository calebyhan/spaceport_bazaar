# Copy this file to .env.local and fill in the values from your Supabase
# project's Connect / API Keys pages. Never commit .env.local.
#
# These are server-only variables. Do not rename either with a NEXT_PUBLIC_
# prefix: the dashboard server and protocol worker are the only processes that
# should receive the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_key

# Standalone worker: supply these through the environment or BAZAAR_ENV_FILE.
# The worker never automatically loads this file or enables remote persistence.
BAZAAR_ENDPOINT=ws://127.0.0.1:3001/ws
BAZAAR_TOKEN=replace_with_your_station_token
BAZAAR_JOURNAL=.local/worker.jsonl
BAZAAR_RESERVE_TICKS=2
BAZAAR_QUANTITY=1
BAZAAR_GIVE_UNITS=1
BAZAAR_RECEIVE_UNITS=1
BAZAAR_TTL=2
BAZAAR_COOLDOWN_TICKS=2
BAZAAR_MAX_OPEN_OFFERS=2
